  m_FontData:
    m_Font: {fileID: 12800000, guid: eb4f61de920244a448c432da22e1bc73, type: 3}
    m_FontSize: 91
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 10
    m_MaxSize: 98
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0422\u0430\u043A \u0436\u0435 \u0435\u0441\u043B\u0438 \u0432\u044B
    \u043F\u0440\u043E\u0439\u0434\u0435\u0442\u0435 \u0438\u0433\u0440\u0443 \u043D\u0430
    \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C \"nightmare\" \u0432\u0430\u043C
    \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E
    \u043C\u043E\u0434 \u043C\u0435\u043D\u044E"
--- !u!114 &4180220308605983468
MonoBehaviour:
  m_ObjectHideFlags: 0
