--- !u!114 &7350356434530935
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5015608659966078063}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: eb4f61de920244a448c432da22e1bc73, type: 3}
    m_FontSize: 91
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 10
    m_MaxSize: 98
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0421\u041F\u0410\u0421\u0418\u0411\u041E \u0417\u0410 \u0422\u041E \u0427\u0422\u041E
    \u0418\u0413\u0420\u0410\u041B\u0418 \u0412 \n<color=red>Angry neighbor: Hardmode</color>\n\u041D\u0410
    \u042D\u0422\u041E\u041C \u041C\u041E\u041C\u0415\u041D\u0422\u0415 \u0411\u0415\u0422\u0410
    \u0417\u0410\u041A\u0410\u041D\u0427\u0418\u0412\u0410\u0415\u0422\u0421\u042F\n\u0435\u0421\u041B\u0418
    \u0425\u041E\u0422\u0418\u0422\u0415 \u0421\u041B\u0415\u0414\u0418\u0422\u042C
    \u0417\u0410 \u0420\u0410\u0417\u0420\u0410\u0411\u041E\u0422\u041A\u041E\u0419
    \u0418\u0413\u0420\u042B, \u0417\u0410\u0425\u041E\u0414\u0418\u0422\u0415 \u0412
    \u041D\u0410\u0428 \u0422\u0415\u041B\u0415\u0413\u0420\u0410\u041C \u041A\u0410\u041D\u0410\u041B!
    \u0422\u0410\u041C \u0411\u0423\u0414\u0415\u0422 \u0411\u041E\u041B\u042C\u0428\u0415
    \u041D\u041E\u0412\u041E\u0421\u0422\u0415\u0419\nt.me/filiposin"
--- !u!114 &5227445197370720319
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5015608659966078063}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bfae57377af16834b91265fb9400df83, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  localizedLine:
    englishText: "THANK YOU FOR PLAYING \r\n<color=red>Angry neighbor: Hardmode</color>\r\nTHIS
      IS HOW THE BETA ENDS\r\nIF YOU WANT TO FOLLOW THE GAME'S DEVELOPMENT, VISIT
      OUR TELEGRAM CHANNEL! MORE NEWS WILL BE THERE\r\nt.me/filiposin"
    russianText: "\u0421\u041F\u0410\u0421\u0418\u0411\u041E \u0417\u0410 \u0422\u041E
      \u0427\u0422\u041E \u0418\u0413\u0420\u0410\u041B\u0418 \u0412 \n<color=red>Angry
      neighbor: Hardmode</color>\n\u041D\u0410 \u042D\u0422\u041E\u041C \u041C\u041E\u041C\u0415\u041D\u0422\u0415
      \u0411\u0415\u0422\u0410 \u0417\u0410\u041A\u0410\u041D\u0427\u0418\u0412\u0410\u0415\u0422\u0421\u042F\n\u0435\u0421\u041B\u0418
      \u0425\u041E\u0422\u0418\u0422\u0415 \u0421\u041B\u0415\u0414\u0418\u0422\u042C
      \u0417\u0410 \u0420\u0410\u0417\u0420\u0410\u0411\u041E\u0422\u041A\u041E\u0419
      \u0418\u0413\u0420\u042B, \u0417\u0410\u0425\u041E\u0414\u0418\u0422\u0415
      \u0412 \u041D\u0410\u0428 \u0422\u0415\u041B\u0415\u0413\u0420\u0410\u041C
      \u041A\u0410\u041D\u0410\u041B! \u0422\u0410\u041C \u0411\u0423\u0414\u0415\u0422
      \u0411\u041E\u041B\u042C\u0428\u0415 \u041D\u041E\u0412\u041E\u0421\u0422\u0415\u0419\nt.me/filiposin"
    spanishText: "GRACIAS POR JUGAR\r\n<color=red>Vecino Enfadado: Modo Dif\xEDcil</color>\r\nAS\xCD
      TERMINA LA BETA\r\nSI QUIERES SEGUIR EL DESARROLLO DEL JUEGO, \xA1VISITA NUESTRO
      CANAL DE TELEGRAM! HABR\xC1 M\xC1S NOTICIAS.\r\nt.me/filiposin"
    turkishText: "OYNADI\u011EINIZ \u0130\xC7\u0130N TE\u015EEKK\xDCR EDER\u0130Z
      \r\n<color=red>Angry neighbor: Hardmode</color>\r\nBETA B\xD6YLE B\u0130T\u0130YOR\r\nOYUNUN
      GEL\u0130\u015E\u0130M\u0130N\u0130 TAK\u0130P ETMEK \u0130STERSEN\u0130Z TELEGRAM
      KANALIMIZI Z\u0130YARET ED\u0130N! DAHA FAZLA HABER ORADA OLACAK\r\nt.me/filiposin"
